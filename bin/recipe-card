class SpecError(Exception):
    pass


# ---------------------------------------------------------------- languages
# Every fixed text a card shows lives here. "labels" can be overridden per
# spec; "hyphenation" is the pyphen dictionary; "hyphen_prefixes" are word
# starts the hyphenation patterns split badly, broken off first.

LANGS = {
    "da": {
        "labels": {
            "recipe_kicker": "Opskrift",
            "ingredients": "Ingredienser",
            "tools": "Redskaber",
            "method": "Fremgangsmåde",
            "plan_kicker": "Madplan",
            "offer": "Tilbud",
            "saving": "Besparelse",
            "total": "i alt",
            "staples": "Basisvarer",
            "week_kicker": "Familiens uge",
            "all_day": "Heldag",
            "nothing_planned": "Intet planlagt",
            "steps_kicker": "Kom i gang",
            "bonus": "Bonus",
            "weekdays": ["Mandag", "Tirsdag", "Onsdag", "Torsdag", "Fredag", "Lørdag", "Søndag"],
            "weekday_abbr": ["MAN", "TIR", "ONS", "TOR", "FRE", "LØR", "SØN"],
            "months": ["jan", "feb", "mar", "apr", "maj", "jun", "jul", "aug", "sep", "okt", "nov", "dec"],
        },
        "hyphenation": "da_DK",
        "hyphen_prefixes": ("gennem", "halv", "fint"),
    },
    "en": {
        "labels": {
            "recipe_kicker": "Recipe",
            "ingredients": "Ingredients",
            "tools": "Equipment",
            "method": "Method",
            "plan_kicker": "Meal plan",
            "offer": "Offer",
            "saving": "Saving",
            "total": "total",
            "staples": "Staples",
            "week_kicker": "The week",
            "all_day": "All day",
            "nothing_planned": "Nothing planned",
            "steps_kicker": "Get started",
            "bonus": "Bonus",
            "weekdays": ["Monday", "Tuesday", "Wednesday", "Thursday", "Friday", "Saturday", "Sunday"],
            "weekday_abbr": ["MON", "TUE", "WED", "THU", "FRI", "SAT", "SUN"],
            "months": ["jan", "feb", "mar", "apr", "may", "jun", "jul", "aug", "sep", "oct", "nov", "dec"],
        },
        "hyphenation": "en_US",
        "hyphen_prefixes": (),
    },
}
LIST_LABELS = {"weekdays": 7, "weekday_abbr": 7, "months": 12}


class Lang:
    """Labels and hyphenation for one card."""

    def __init__(self, code="da", overrides=None):
        pack = LANGS[code]
        self.labels = {**pack["labels"], **(overrides or {})}
        self.prefixes = pack["hyphen_prefixes"]
        self.hyphen = None
        if pyphen is not None:
            try:
                self.hyphen = pyphen.Pyphen(lang=pack["hyphenation"], left=3, right=4)
            except KeyError:
                pass

    def __getitem__(self, key):
        return self.labels[key]

    def weekday(self, name):
        """(abbreviation, index 0-6 or None) for a weekday name or abbreviation."""
        key = name.strip().rstrip(".").lower()
        for index, (full, abbr) in enumerate(zip(self["weekdays"], self["weekday_abbr"])):
            if key in (full.lower(), abbr.lower()):
                return abbr, index
        return name.strip()[:3].upper(), None

    def month(self, number):
        try:
            index = int(number)
        except ValueError:
            return number
        return self["months"][index - 1] if 1 <= index <= 12 else number

    def lines(self, text, hyphenate=False):
        """Escape text; `\\n` becomes a line break. With hyphenate, long words
        get soft hyphens so narrow columns break at syllables, not mid-letter."""
        def word(token):
            if self.hyphen is None or len(token) < 9 or not token.isalpha():
                return html.escape(token)
            for prefix in self.prefixes:
                if token.lower().startswith(prefix) and len(token) - len(prefix) >= 4:
                    stem = token[len(prefix):]
                    parts = [token[:len(prefix)], *self.hyphen.inserted(stem).split("-")]
                    return "&shy;".join(html.escape(part) for part in parts)
            return "&shy;".join(html.escape(part) for part in self.hyphen.inserted(token).split("-"))

        def line(raw):
            if not hyphenate:
                return html.escape(raw)
            return "".join(word(token) for token in re.split(r"(\W+)", raw))

        return "<br>".join(line(raw) for raw in text.strip().split("\n"))


def check_lang(spec):
    """Validate "lang" and "labels"; return a Lang. Raises SpecError."""
    code = spec.get("lang", "da")
    if code not in LANGS:
        raise SpecError(f'"lang" must be one of {", ".join(LANGS)}')
    overrides = spec.get("labels", {})
    if not isinstance(overrides, dict):
        raise SpecError('"labels" must be an object of label: text')
    known = LANGS[code]["labels"]
    for key, value in overrides.items():
        if key not in known:
            raise SpecError(f'unknown label "{key}" (allowed: {", ".join(known)})')
        if key in LIST_LABELS:
            if (not isinstance(value, list) or len(value) != LIST_LABELS[key]
                    or not all(isinstance(v, str) and v.strip() for v in value)):
                raise SpecError(f'label "{key}" must be a list of {LIST_LABELS[key]} non-empty strings')
        elif not isinstance(value, str) or not value.strip():
            raise SpecError(f'label "{key}" must be a non-empty string')
    return Lang(code, overrides)


# ---------------------------------------------------------------- shared look

FONT_FILES = {
    "Playfair Display": ("playfair-display/PlayfairDisplay[wght].ttf", "400 900"),
    "Josefin Sans": ("josefin-sans/JosefinSans[wght].ttf", "100 700"),
    "Space Grotesk": ("space-grotesk/SpaceGrotesk[wght].ttf", "300 700"),
}
_FONT_CACHE = {}


def font_css(*families):
    """@font-face rules with the repo's fonts embedded as data URLs, so no
    system font or file-access rule changes how a card looks."""
    rules = []
    for family in families:
        path, weights = FONT_FILES[family]
        if family not in _FONT_CACHE:
            file = FONTS / path
            try:
                _FONT_CACHE[family] = base64.b64encode(file.read_bytes()).decode("ascii")
            except OSError as error:
                raise RuntimeError(f"font missing: {file} ({error.strerror})") from error
        rules.append(f'@font-face {{ font-family: "{family}"; font-style: normal; font-weight: {weights}; '
                     f'src: url(data:font/ttf;base64,{_FONT_CACHE[family]}) format("truetype"); }}')
    return "\n".join(rules)


