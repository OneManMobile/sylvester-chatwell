+  /**
+   * Every product on nemlig.com's offers page (/tilbud), grouped by the
+   * page's sections. The page JSON lists sections with a ProductGroupId; the
+   * products come from the same signed-in endpoint the website uses, priced
+   * for the account's delivery zone and timeslot.
+   */
+  async offers({ categories = [] } = {}) {
+    const page = await fetchJson(this.fetchImpl, `${SITE_ORIGIN}/tilbud?GetAsJson=1`, {
+      headers: publicHeaders(),
+    });
+    const wanted = categories.map((name) => name.toLowerCase());
+    const sections = (page?.content ?? []).filter((spot) =>
+      spot?.ProductGroupId && String(spot.TemplateName).startsWith("productlist") &&
+      (!wanted.length || wanted.some((name) => String(spot.Heading).toLowerCase().includes(name)))
+    );
+    if (!sections.length) {
+      throw new NemligApiError(
+        wanted.length ? `No offer section matches: ${categories.join(", ")}` : "nemlig.com offers page has no product sections",
+      );
+    }
+    const [user, basket, session] = await Promise.all([
+      this.currentUser(),
+      this.getBasket(),
+      this.getSession(),
+    ]);
+    const settings = session.settings;
+    const base = [
+      "/webapi",
+      settings.CombinedProductsAndSitecoreTimestamp,
+      basket?.TimeslotUtc || settings.TimeslotUtc,
+      basket?.DeliveryZoneId ?? settings.DeliveryZoneId,
+      user.DebitorId,
+      "Products",
+    ].join("/");
+    const result = [];
+    for (const section of sections) {
+      const products = [];
+      for (let pageIndex = 0; pageIndex < 20; pageIndex += 1) {
+        const url = new URL(`${base}/GetByProductGroupId`, SITE_ORIGIN);
+        url.searchParams.set("productGroupId", section.ProductGroupId);
+        url.searchParams.set("pageIndex", String(pageIndex));
+        url.searchParams.set("pagesize", "50");
+        const chunk = await this.accountFetch(url);
+        products.push(...(chunk?.Products ?? []));
+        if (!chunk?.Products?.length || products.length >= (chunk.NumFound ?? 0)) break;
+      }
+      result.push({ section: section.Heading, total: section.TotalProducts, products });
+    }
+    return result;
+  }
+
