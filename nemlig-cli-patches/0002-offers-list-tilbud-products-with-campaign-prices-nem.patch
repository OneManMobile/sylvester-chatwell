+/**
+ * One offer product in a stable shape. Multi-buy campaigns ("3 for 85 kr")
+ * report the total for MinQuantity items, so the per-item price divides it.
+ */
+function normalizeOffer(section, product) {
+  const campaign = product.Campaign ?? null;
+  const minQuantity = Math.max(Number(campaign?.MinQuantity) || 1, 1);
+  const campaignPrice = Number(campaign?.CampaignPrice);
+  const price = Number(product.Price);
+  const offerEach = Number.isFinite(campaignPrice) && campaignPrice > 0
+    ? Math.round((campaignPrice / minQuantity) * 100) / 100
+    : price;
+  const description = String(product.Description ?? "");
+  return {
+    section,
+    id: String(product.Id),
+    name: product.Name,
+    brand: product.Brand ?? null,
+    description,
+    price,
+    offerPriceEach: offerEach,
+    minQuantity,
+    offerTotal: Number.isFinite(campaignPrice) && campaignPrice > 0 ? campaignPrice : null,
+    savingPercent: price > 0 ? Math.round((1 - offerEach / price) * 100) : 0,
+    unitPrice: product.UnitPriceCalc ?? null,
+    unitLabel: product.UnitPriceLabel ?? null,
+    frozen: /\bfrost\b|frossen|dybfrost/i.test(description),
+    organic: /øko|økologisk/i.test(`${product.Name} ${description}`),
+  };
+}
+
+function renderOffers(offers) {
+  if (!offers.length) return "No offers found.";
+  const lines = [];
+  let section = null;
+  for (const offer of offers) {
+    if (offer.section !== section) {
+      section = offer.section;
+      lines.push("", `## ${section}`);
+    }
+    const deal = offer.minQuantity > 1
+      ? `${offer.minQuantity} for ${offer.offerTotal} kr (${offer.offerPriceEach} each)`
+      : `${offer.offerPriceEach} kr`;
+    const flags = [offer.frozen ? "FROST" : "", offer.organic ? "øko" : ""].filter(Boolean).join(" ");
+    lines.push(`${offer.id}  ${offer.name} — ${offer.description} — ${offer.price} → ${deal} (-${offer.savingPercent}%)${flags ? `  [${flags}]` : ""}`);
+  }
+  return lines.join("\n").trim();
+}
