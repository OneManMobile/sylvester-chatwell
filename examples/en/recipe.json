{
  "lang": "en",
  "title": "Danish meatballs with potatoes and brown gravy",
  "subtitle": "4 servings · approx. 50 min",
  "start": [
    "Put water on for the potatoes"
  ],
  "tools": [
    "Large frying pan",
    "Pot with lid",
    "Grater",
    "Bowl"
  ],
  "recipe": {
    "do": "Serve with\npotatoes\nand gravy.\nSalad on\nthe side",
    "with": [
      {
        "do": "Boil 15–20 min\nwith the lid on",
        "with": [
          {
            "amount": "1 kg",
            "name": "potatoes"
          },
          {
            "amount": "1 tsp",
            "name": "salt"
          }
        ]
      },
      {
        "do": "Lift out\nmeatballs.\nWhisk flour\ninto water,\nboil 3 min",
        "with": [
          {
            "do": "Mix, roll\n12 balls.\nFry 6 min\na side",
            "with": [
              {
                "amount": "1",
                "name": "onion, finely grated"
              },
              {
                "amount": "500 g",
                "name": "minced pork"
              },
              {
                "amount": "1",
                "name": "egg"
              },
              {
                "amount": "3 tbsp",
                "name": "rolled oats"
              },
              {
                "amount": "1 dl",
                "name": "milk"
              },
              {
                "amount": "1 tsp",
                "name": "salt and pepper"
              },
              {
                "amount": "30 g",
                "name": "butter"
              }
            ]
          },
          {
            "amount": "3 dl",
            "name": "water"
          },
          {
            "amount": "2 tbsp",
            "name": "plain flour"
          },
          {
            "amount": "1",
            "name": "stock cube"
          }
        ]
      },
      {
        "do": "Slice thinly, toss\nwith vinegar\nand sugar",
        "with": [
          {
            "amount": "1",
            "name": "cucumber"
          },
          {
            "amount": "½ dl",
            "name": "vinegar"
          },
          {
            "amount": "2 tbsp",
            "name": "sugar"
          }
        ]
      }
    ]
  }
}
